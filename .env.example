# Local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-32k

# FilmDubUA / Ukrainian TTS
# Keep real credentials only in your local .env file.
FILMDUBUA_PATH=C:\FilmDubUA
FILMDUBUA_VOICE=
FILMDUBUA_TOKEN=
FILMDUBUA_VOICE_PROFILE=neutral
TTS_RATE=170
TTS_VOLUME=1.0

# Media providers
IMAGE_PROVIDER=local
MUSIC_PROVIDER=local
SFX_PROVIDER=local

# Rendering
FFMPEG_BIN=ffmpeg
OUTPUT_FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
