# Local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-32k

# FilmDubUA / Ukrainian TTS
# Keep real credentials only in your local .env file.
FILMDUBUA_PATH=C:\FilmDubUA
FILMDUBUA_VOICE=
FILMDUBUA_TOKEN=
FILMDUBUA_VOICE_PROFILE=neutral
TTS_RATE=170
TTS_VOLUME=1.0

# Local image generation (Automatic1111-compatible API)
IMAGE_API_URL=http://127.0.0.1:7860
IMAGE_MODEL=
# GT 1030-friendly defaults. The final renderer upscales to 1920x1080.
IMAGE_WIDTH=640
IMAGE_HEIGHT=360
IMAGE_STEPS=16
IMAGE_CFG_SCALE=7.0
IMAGE_TIMEOUT=900

# Media providers
IMAGE_PROVIDER=local
MUSIC_PROVIDER=procedural
SFX_PROVIDER=procedural

# Rendering
FFMPEG_BIN=ffmpeg
OUTPUT_FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
